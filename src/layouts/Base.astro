---
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/page.css';
import '../styles/terminal.css';
import '../styles/scene.css';
import jbRegular from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import markFont from '../assets/fonts/vt323-mark.woff2?url';
import { CONTACTS, SITE } from '../content/site';
import { TOKENS } from '../lib/tokens';
import Toggles from '../components/Toggles.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  index?: boolean;
}
const { title, description, path, index = true } = Astro.props;
const url = new URL(path, SITE.url).href;
const og = new URL('/og.png', SITE.url).href;
const dark = TOKENS.semantic.dark.bg;
const light = TOKENS.semantic.light.bg;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  alternateName: SITE.handle,
  jobTitle: 'Tech Lead',
  worksFor: { '@type': 'Organization', name: SITE.company },
  address: { '@type': 'PostalAddress', addressCountry: SITE.countryCode },
  url: `${SITE.url}/`,
  sameAs: CONTACTS.filter((c) => c.href.startsWith('https:')).map((c) => c.href),
};
const ld = JSON.stringify(person).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {index ? <link rel="canonical" href={url} /> : <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content={dark} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content={light} media="(prefers-color-scheme: light)" />
    <script is:inline define:vars={{ dark, light }}>
      var d = document.documentElement, t = null;
      try { t = localStorage.getItem('alxnko:theme'); } catch (e) {}
      if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      d.dataset.theme = t;
      d.classList.add('js');
      document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.content = t === 'light' ? light : dark; });
    </script>
    <link rel="preload" href={jbRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={markFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="alxnko.dev" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="alxnko's desk: a laptop running a terminal and an ultrawide monitor" />
    <meta property="profile:username" content={SITE.handle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script type="application/ld+json" set:html={ld} />
  </head>
  <body id="app" data-mode="page">
    <a class="skip" href="#term-input">skip to terminal</a>
    <header class="bar">
      <a class="bar-home" href="/" aria-label="alxnko.dev home">alxnko.dev</a>
      <span class="bar-meta num" aria-hidden="true">{SITE.coords.toLowerCase()}</span>
      <slot name="bar" />
      <Toggles />
    </header>
    <slot />
    <footer class="foot">
      <p>alxnko.dev <span aria-hidden="true">·</span> {SITE.os} rolling <span aria-hidden="true">·</span> {SITE.country.toLowerCase()}</p>
      <p class="num">© 2026 {SITE.name.toLowerCase()}</p>
    </footer>
    <script>
      import '../ui/entry';
    </script>
  </body>
</html>
