---
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/page.css';
import '../styles/terminal.css';
import '../styles/scene.css';
import jbRegular from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import markFont from '../assets/fonts/vt323-mark.woff2?url';
import { CONTACTS, SITE } from '../content/site';
import { TOKENS } from '../lib/tokens';
import Toggles from '../components/Toggles.astro';

interface Props {
  /** The home page: boots straight into the 3D desk when the device can run it. */
  desk?: boolean;
  title: string;
  description: string;
  path: string;
  index?: boolean;
}
const { title, description, path, index = true, desk = false } = Astro.props;
const url = new URL(path, SITE.url).href;
const og = new URL('/og.png', SITE.url).href;
const dark = TOKENS.semantic.dark.bg;
const light = TOKENS.semantic.light.bg;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  alternateName: SITE.handle,
  jobTitle: 'Tech Lead',
  address: { '@type': 'PostalAddress', addressCountry: SITE.countryCode },
  url: `${SITE.url}/`,
  sameAs: CONTACTS.filter((c) => c.href.startsWith('https:')).map((c) => c.href),
};
const ld = JSON.stringify(person).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {index ? <link rel="canonical" href={url} /> : <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content={dark} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content={light} media="(prefers-color-scheme: light)" />
    <script is:inline define:vars={{ dark, light }}>
      var d = document.documentElement, t = null;
      try {
        t = localStorage.getItem('alxnko:theme');
        // one-time move from the old site's key, so the saved choice keeps winning
        if (!t && (t = localStorage.getItem('alxnko-theme'))) { localStorage.setItem('alxnko:theme', t); localStorage.removeItem('alxnko-theme'); }
      } catch (e) {}
      if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      d.dataset.theme = t;
      d.classList.add('js');
      document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.content = t === 'light' ? light : dark; });
    </script>
    {desk && (
      <script is:inline>
        // Decide before first paint whether this visit boots into the 3D desk (mirrors
        // decide3D in src/scene/gate.ts). If so, the flat page never flashes: a tty loader
        // shows until the desk is ready, or until loading fails and the page takes over.
        (function () {
          try {
            var d = document.documentElement, q = location.search, n = navigator, c = n.connection || {};
            var cv = document.createElement('canvas'), gl = cv.getContext('webgl2');
            d.dataset.gl = gl ? '2' : '0'; // entry.ts reuses this instead of probing again
            if (!gl) return;
            var lose = gl.getExtension('WEBGL_lose_context');
            if (lose) lose.loseContext();
            var force = /[?&]3d(&|=|$)/.test(q);
            if (!force && /[?&]lite(&|=|$)/.test(q)) return;
            if (!force) {
              if (c.saveData || /(^|-)2g$/.test(c.effectiveType || '')) return;
              if ((n.hardwareConcurrency && n.hardwareConcurrency < 4) || (n.deviceMemory && n.deviceMemory < 4)) return;
            }
            d.dataset.boot = '3d';
            // watchdog: if the desk is not up after 15 s of the page being shown (script
            // blocked, stale cached HTML, stalled download), reveal the page rather than a
            // loader forever. Hidden time doesn't count (same rule as the mount deadline).
            var left = 15000, since = Date.now();
            (function tick() {
              var now = Date.now();
              if (!document.hidden) left -= now - since;
              since = now;
              if (document.body && document.body.dataset.scene === 'ready') return;
              if (left <= 0) { delete d.dataset.boot; return; }
              setTimeout(tick, Math.min(1000, left));
            })();
          } catch (e) {}
        })();
      </script>
    )}
    <link rel="preload" href={jbRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={markFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="alxnko.dev" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="alxnko's desk: a laptop running a terminal and an ultrawide monitor" />
    <meta property="profile:username" content={SITE.handle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script type="application/ld+json" set:html={ld} />
  </head>
  <body id="app" data-mode="page">
    {desk && (
      <div id="loader" class="loader" role="status" aria-live="polite">
        <div class="loader-tty">
          <p class="loader-head"><span>tty1</span><span>{SITE.handle}@{SITE.host}</span></p>
          <ol id="loader-steps" class="loader-steps">
            <li data-step="manifest"><span class="st">[      ]</span> Reading scene manifest</li>
            <li data-step="geometry"><span class="st">[      ]</span> Loading desk geometry</li>
            <li data-step="lighting"><span class="st">[      ]</span> Baking in the lights</li>
            <li data-step="screens"><span class="st">[      ]</span> Waking up the screens</li>
          </ol>
          <div class="loader-bar" aria-hidden="true"><span id="loader-fill"></span></div>
        </div>
      </div>
    )}
    <a class="skip" href="#term-input">skip to terminal</a>
    <header class="bar">
      <a class="bar-home" href="/" aria-label="alxnko.dev home">alxnko.dev</a>
      <slot name="bar" />
      <Toggles />
    </header>
    <slot />
    <footer class="foot">
      <p>alxnko.dev <span aria-hidden="true">·</span> {SITE.os} rolling <span aria-hidden="true">·</span> {SITE.country.toLowerCase()}</p>
      <p class="num">© 2026 {SITE.name.toLowerCase()}</p>
    </footer>
    <script>
      import '../ui/entry';
    </script>
  </body>
</html>
