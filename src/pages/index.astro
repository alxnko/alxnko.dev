---
import "../styles/global.css";
import ThemeScript from "../components/ThemeScript.astro";
import Icons from "../components/Icons.astro";
import Terminal from "../components/Terminal.astro";

const socialLinks = [
  { name: "GitHub", path: "/gh", url: "https://github.com/alxnko", icon: "github" as const, desc: "code & repositories" },
  { name: "Telegram", path: "/tg", url: "https://t.me/ALXNK0", icon: "telegram" as const, desc: "direct messaging" },
  { name: "LinkedIn", path: "/in", url: "https://linkedin.com/in/alxnko", icon: "linkedin" as const, desc: "professional network" },
  { name: "Instagram", path: "/ig", url: "https://instagram.com/alxnko", icon: "instagram" as const, desc: "life & visuals" },
  { name: "Email", path: "/mail", url: "mailto:aleksandrnyrko@gmail.com", icon: "mail" as const, desc: "aleksandrnyrko@gmail.com" },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>alxnko — software engineer & systems architect</title>
  <meta name="description" content="Personal website and links hub of alxnko (Alex Neko) — building resilient distributed edge systems and modern web software." />
  <link rel="canonical" href="https://alxnko.dev/" />

  <!-- Icons: generated by packages/brand (bash packages/brand/scripts/build.sh). -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.webp" type="image/webp" sizes="32x32" />
  <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- OpenGraph / Social Meta -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://alxnko.dev/" />
  <meta property="og:title" content="alxnko — software engineer & systems architect" />
  <meta property="og:description" content="Personal portfolio and fast shortcuts of alxnko (Alex Neko). Explore code, projects, and connect." />
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:title" content="alxnko — software engineer & systems architect" />
  <meta property="twitter:description" content="Personal portfolio and fast shortcuts of alxnko (Alex Neko). Explore code, projects, and connect." />

  <!-- Pre-render theme switcher to prevent FOUC -->
  <ThemeScript />
</head>
<body>
  <!-- Global Header -->
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo-link" aria-label="alxnko home">
        <span class="logo-prompt">&gt;</span>
        <span class="logo-brand">alxnko</span><span class="logo-suffix">.dev</span>
      </a>

      <div>
        <button type="button" class="theme-btn" id="theme-toggle" aria-label="Toggle light or dark theme" title="Toggle theme">
          <span id="theme-icon-moon"><Icons name="moon" size={17} /></span>
          <span id="theme-icon-sun" style="display: none;"><Icons name="sun" size={17} /></span>
        </button>
      </div>
    </div>
  </header>

  <main class="container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="tagline">// software engineer & systems builder</div>
      <div class="hero-title-group">
        <h1 class="hero-title">Alex Neko</h1>
        <span class="hero-handle">alxnko</span>
      </div>
      <p class="hero-desc">
        Specializing in high-performance distributed edge systems, real-time protocols, and craft-driven web platforms.
      </p>

      <!-- Fast Shortcuts / Link Hub -->
      <div class="fast-links">
        {socialLinks.map((item) => (
          <a href={item.path} class="fast-card" title={`Go to ${item.name} (${item.path})`} target="_blank" rel="noopener noreferrer">
            <div class="fast-card-header">
              <Icons name={item.icon} class="fast-card-icon" size={19} />
              <Icons name="external" class="fast-card-ext" size={12} />
            </div>
            <span class="fast-card-name">{item.name}</span>
            <span class="fast-card-path">{item.path}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Interactive Terminal Widget -->
    <section>
      <h2 class="section-title"><span class="hash">#</span> interactive_console</h2>
      <Terminal />
    </section>
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand-row">
        <span class="footer-brand">alxnko.dev</span>
        <span class="footer-sep">&bull;</span>
        <span class="footer-copy">crafted with code &bull; 2026</span>
      </div>
      <div class="footer-links">
        <a href="/gh">github</a>
        <a href="/tg">telegram</a>
        <a href="/in">linkedin</a>
        <a href="/ig">instagram</a>
        <a href="/mail">email</a>
      </div>
    </div>
  </footer>

  <!-- Theme toggle client logic -->
  <script is:inline>
    (function() {
      var btn = document.getElementById('theme-toggle');
      var moon = document.getElementById('theme-icon-moon');
      var sun = document.getElementById('theme-icon-sun');

      function updateIcons(theme) {
        if (theme === 'light') {
          moon.style.display = 'none';
          sun.style.display = 'inline-flex';
        } else {
          moon.style.display = 'inline-flex';
          sun.style.display = 'none';
        }
      }

      var current = document.documentElement.getAttribute('data-theme') || 'dark';
      updateIcons(current);

      if (btn) {
        btn.addEventListener('click', function() {
          var now = document.documentElement.getAttribute('data-theme');
          var next = now === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('alxnko-theme', next); } catch(e) {}
          updateIcons(next);
        });
      }

      // Listen for system theme changes if user hasn't overridden
      try {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
          if (!localStorage.getItem('alxnko-theme')) {
            var autoTheme = e.matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', autoTheme);
            updateIcons(autoTheme);
          }
        });
      } catch (e) {}
    })();
  </script>
</body>
</html>
