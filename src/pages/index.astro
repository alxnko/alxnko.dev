---
import Base from '../layouts/Base.astro';
import Identity from '../components/Identity.astro';
import Terminal from '../components/Terminal.astro';
import Contacts from '../components/Contacts.astro';
import Nav from '../components/Nav.astro';
import Promo from '../components/Promo.astro';
import Icon from '../components/Icon.astro';
import { MEOWSENGER, MEOWSENGER_PITCH, SITE } from '../content/site';
import { readPosters } from '../lib/poster';

const posters = readPosters();
const title = `alex neko (${SITE.handle}) · ${SITE.role}`;
const description =
  `${SITE.name} (${SITE.handle}): ${SITE.role} in ${SITE.country}, ` +
  `${SITE.rank.text}. A working terminal on a model of the desk: type help.`;
const tset = (k: 'wide' | 'tall', f: 'avif' | 'webp') =>
  posters ? JSON.stringify({ day: posters.day[k][f], night: posters.night[k][f] }) : '';
const PORTRAIT = '(max-width: 719px)';
---
<Base title={title} description={description} path="/" desk>
  <button slot="bar" id="enter3d" class="bar-btn" type="button" hidden>enter 3d</button>
  <div id="stage" aria-hidden="true"></div>
  <main class="sheet" id="main">
    <Identity />
    <Terminal />
    <Contacts />
    <Promo />
    {/* The monitor's right pane (3D only). Role/loc/rank repeat the identity, so they stay out
        of the accessibility tree; the meowsenger card (owner decision 2026-10-31) is the pane's
        own content and a real link. The whole list is inert until the camera is at the monitor
        (syncMonitorLinks in entry.ts). */}
    <aside id="mon-info" class="mon-info" aria-label="meowsenger">
      <dl>
        <div aria-hidden="true"><dt>role</dt><dd>{SITE.role}</dd></div>
        <div aria-hidden="true"><dt>loc</dt><dd>{SITE.country}</dd></div>
        <div aria-hidden="true"><dt>rank</dt><dd><a href={SITE.rank.href} target="_blank" rel="noopener noreferrer" tabindex="-1">{SITE.rank.short}</a></dd></div>
        <div class="mp">
          <dt aria-hidden="true">chat</dt>
          <dd>
            <a id="mon-promo" class="mp-card" data-promo="meowsenger" href={MEOWSENGER} target="_blank" rel="noopener noreferrer">
              <span class="mp-head"><span class="mp-cat" aria-hidden="true"></span>meowsenger</span>
              <span class="mp-msg">{MEOWSENGER_PITCH}</span>
              <span class="mp-typing" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="mp-url">{MEOWSENGER.replace('https://', '')}<span class="visually-hidden"> (opens in a new tab)</span></span>
            </a>
          </dd>
        </div>
      </dl>
    </aside>
    {posters && (
      <figure class="poster">
        <picture id="poster">
          {(['avif', 'webp'] as const).flatMap((f) => [
            <source type={`image/${f}`} media={`${PORTRAIT} and (prefers-color-scheme: light)`} srcset={posters.day.tall[f]} width="800" height="1000" data-theme-src={tset('tall', f)} />,
            <source type={`image/${f}`} media={PORTRAIT} srcset={posters.night.tall[f]} width="800" height="1000" data-theme-src={tset('tall', f)} />,
            <source type={`image/${f}`} media="(prefers-color-scheme: light)" srcset={posters.day.wide[f]} width="1600" height="1000" data-theme-src={tset('wide', f)} />,
            <source type={`image/${f}`} srcset={posters.night.wide[f]} width="1600" height="1000" data-theme-src={tset('wide', f)} />,
          ])}
          <img
            src={posters.night.wide.webp}
            width="1600"
            height="1000"
            alt="alxnko's desk: a sit-stand desk with a laptop running this terminal, a curved ultrawide showing contacts, and a green faceted cat on a desk fan"
            decoding="async"
            loading="lazy"
            data-theme-src={tset('wide', 'webp')}
          />
        </picture>
        <figcaption><span>fig. 1</span> the desk, baked in blender</figcaption>
      </figure>
    )}
  </main>
  <button id="back" class="back" type="button" hidden aria-keyshortcuts="Escape">
    <span aria-hidden="true">←</span> desk <kbd>esc</kbd>
  </button>
  <button id="intr" class="intr" type="button" hidden aria-keyshortcuts="Control+C">
    <kbd>^C</kbd> stop
  </button>
  <button id="noui-exit" class="noui-exit" type="button" aria-label="show the interface (Esc)" hidden>
    <Icon name="eye" size={18} />
  </button>
  <Nav />
  <p id="hint" class="hint"><span class="hint-fine">type anywhere · drag to look around · scroll to zoom</span><span class="hint-touch">tap a screen · drag to look around · pinch to zoom</span></p>
</Base>
