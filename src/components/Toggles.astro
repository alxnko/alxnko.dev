---
import Icon from './Icon.astro';
---
<div class="toggles">
  <button id="t-theme" class="toggle" type="button" aria-pressed="false" aria-label="day theme">
    <Icon name="sun" /><span class="toggle-label" aria-hidden="true">day</span>
  </button>
  <button id="t-view" class="toggle toggle-view" type="button" aria-label="view mode: hide the interface and look around freely">
    <Icon name="view" /><span class="toggle-label" aria-hidden="true">view</span>
  </button>
  <button id="t-sound" class="toggle" type="button" aria-pressed="false" aria-label="sound">
    <Icon name="sound" /><span class="toggle-label" aria-hidden="true">sound</span>
  </button>
</div>
