---
import { SITE } from '../content/site';
const CHIPS = ['help', 'whoami', 'ls monitor', 'fastfetch', 'desk up'];
const pre = `[${SITE.handle}@${SITE.host} `;
const post = ']$ ';
---
<section id="term" class="term" aria-labelledby="term-h">
  <header class="term-head">
    <h2 id="term-h" class="term-title">tty1 <span class="dim">— {SITE.handle}@{SITE.host}</span></h2>
    <span class="term-clock" aria-hidden="true">kg <time id="clock" class="num"></time></span>
  </header>
  <div id="term-screen" class="term-screen" role="log" aria-live="polite" aria-label="terminal output" tabindex="0">
    <div id="term-lines" class="term-lines">
      <div class="ln">{pre}<span class="c-green">~</span>{post}whoami</div>
      <div class="ln">{SITE.name.toLowerCase()} · {SITE.role} · {SITE.country.toLowerCase()}</div>
    </div>
    <div id="term-comp" class="term-comp" hidden></div>
    <div id="term-overlay" class="term-overlay" aria-hidden="true" hidden></div>
  </div>
  <form id="term-form" class="term-form" data-busy="false">
    <label class="visually-hidden" for="term-input">terminal command</label>
    <span id="term-prompt" class="term-prompt" aria-hidden="true"></span>
    <div class="term-field">
      <div id="term-mirror" class="term-mirror" aria-hidden="true"></div>
      <input
        id="term-input"
        type="text"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        enterkeyhint="send"
        maxlength="256"
      />
    </div>
  </form>
  <div id="term-chips" class="term-chips" role="group" aria-label="suggested commands">
    {CHIPS.map((c) => <button type="button" class="chip" data-cmd={c}>{c}</button>)}
  </div>
</section>
