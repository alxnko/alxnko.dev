---
// Fallback for /gh, /tg, … when _redirects is not applied (e.g. local preview).
import '../styles/tokens.css';
interface Props {
  target: string;
  title: string;
}
const { target, title } = Astro.props;
// noindex and no canonical: the two together are mixed signals, and a mailto: canonical is invalid.
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · alxnko</title>
  <meta name="robots" content="noindex" />
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <!-- Icons only: this page redirects immediately, so no manifest/touch-icon fetch. -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-content: center;
      padding: var(--sp-4);
      background: var(--c-bg);
      color: var(--c-fg-muted);
      font: var(--fs-3) / 1.6 ui-monospace, monospace;
    }
    a {
      color: var(--c-fg);
      text-underline-offset: 3px;
      overflow-wrap: anywhere;
    }
  </style>
</head>
<body>
  <!-- the markers below keep Cloudflare from obfuscating the address (no email-decode script, R79) -->
  <!--email_off--><p>redirecting: {title}<br /><a href={target}>{target}</a></p><!--/email_off-->
  <script define:vars={{ target }}>
    window.location.replace(target);
  </script>
</body>
</html>
