---
interface Props {
  target: string;
  title: string;
}
const { target, title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — alxnko</title>
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <link rel="canonical" href={target} />
  <!-- Icons only: this page redirects immediately, so no manifest/touch-icon fetch. -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.webp" type="image/webp" sizes="32x32" />
  <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
  <style>
    :root { color-scheme: dark; }
    body {
      margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
      background: #08090c; color: #f1f5f9; font-family: 'JetBrains Mono', monospace, monospace;
      padding: 1rem; box-sizing: border-box; text-align: center;
    }
    .card {
      background: #11131a; border: 1px solid #222634; border-radius: 10px; padding: 2rem;
      max-width: 440px; width: 100%; box-shadow: 0 8px 32px rgba(0,0,0,0.6);
    }
    .status { color: #22c55e; font-size: 0.85rem; margin-bottom: 0.75rem; }
    h1 { font-size: 1.15rem; margin: 0 0 1rem; font-weight: 500; }
    a { color: #22c55e; text-decoration: none; word-break: break-all; }
    a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div class="card">
    <div class="status">⚡ redirecting...</div>
    <h1>{title}</h1>
    <p>taking you to <a href={target}>{target}</a></p>
  </div>
  <script define:vars={{ target }}>
    window.location.replace(target);
  </script>
</body>
</html>
