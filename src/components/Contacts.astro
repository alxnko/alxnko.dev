---
import { CONTACTS, MEOWSENGER } from '../content/site';
import Icon from './Icon.astro';
---
<section id="contacts" class="contacts" aria-labelledby="contacts-h">
  <h2 id="contacts-h" class="label">
    <span>contacts</span><span class="label-path" aria-hidden="true">~/monitor/*.lnk</span>
  </h2>
  {/* the markers keep Cloudflare from obfuscating the (public) address into a script-decoded
      span (its email-decode script writes innerHTML, which Trusted Types refuse, R79) */}
  <!--email_off--><ul>
    {CONTACTS.map((c) => (
      <li>
        <a data-contact={c.id} href={c.href} target={c.id === 'email' ? undefined : '_blank'} rel={c.id === 'email' ? undefined : 'noopener noreferrer me'}>
          <span class="c-key" aria-hidden="true">{c.short}</span>
          <span class="c-val"><span class="visually-hidden">{c.label}: </span>{c.display}{c.id !== 'email' && <span class="visually-hidden"> (opens in a new tab)</span>}</span>
          <Icon name="arrow" size={12} class="c-go" />
        </a>
      </li>
    ))}
    {/* portrait screens in 3D only (scene.css): the monitor's side pane is off-view there, so
        its meowsenger card becomes a compact sixth row, marked as an app, not a contact
        (owner decision 2026-10-31). Hidden everywhere else, so never focusable twice. */}
    <li class="ct-promo">
      <a data-promo="meowsenger" href={MEOWSENGER} target="_blank" rel="noopener noreferrer">
        <span class="c-key" aria-hidden="true">chat</span>
        <span class="c-val"><span class="visually-hidden">meowsenger app: </span>{MEOWSENGER.replace('https://', '')}<span class="visually-hidden"> (opens in a new tab)</span></span>
        <span class="ct-tag" aria-hidden="true">app</span>
      </a>
    </li>
  </ul><!--/email_off-->
  <div id="contacts-rain" class="rain" aria-hidden="true" hidden></div>
</section>
